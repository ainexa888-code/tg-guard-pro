# TG GUARD PRO V3 - Environment Configuration Example

# Telegram Configuration
BOT_NAME="TG GUARD PRO"
BOT_USERNAME="tg_guard_pro_bot"
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
OWNER_ID=123456789
LOG_CHAT_ID=-1001234567890
SUPPORT_USERNAME="support_admin"

# Database Configuration (PostgreSQL in production; SQLite fallback supported)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tg_guard_pro"
# Local alternative: sqlite+aiosqlite:///tg_guard_pro.db

# Redis Configuration (Optional; In-memory fallback used if omitted or unavailable)
REDIS_URL="redis://localhost:6379/0"

# Application Settings
ENVIRONMENT="production"
LOG_LEVEL="INFO"
TIMEZONE="Asia/Kolkata"
DEFAULT_LANGUAGE="Hindi"
SECONDARY_LANGUAGE="English"

# Monitoring (Optional)
SENTRY_DSN=""
